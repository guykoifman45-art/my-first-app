# Default Gate 1 image for Python repos (generated by tools/docker_gate.py when the repo has no Dockerfile).
FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
COPY requirements*.txt pyproject.toml* setup.cfg* ./
RUN set -eux; \
    if ls requirements*.txt >/dev/null 2>&1; then for f in requirements*.txt; do pip install -r "$f"; done; fi; \
    pip install pytest
COPY . .
RUN if [ -f pyproject.toml ]; then pip install -e . 2>/dev/null || true; fi
CMD ["pytest", "-q"]
